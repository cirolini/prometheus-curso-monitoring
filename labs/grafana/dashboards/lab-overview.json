{
  "uid": "curso-prometheus-lab",
  "title": "Curso Prometheus — visao geral do lab",
  "description": "Dashboard do lab do curso. Cada painel usa uma consulta que aparece nas licoes.",
  "tags": [
    "curso",
    "lab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Targets no ar",
      "description": "Quantos alvos o Prometheus esta' conseguindo coletar agora.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "count(up == 1)",
          "legendFormat": "",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Targets fora do ar",
      "description": "Se este numero for maior que zero, o alerta InstanceDown vai disparar.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "count(up == 0) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Series na TSDB",
      "description": "Series ativas na memoria. E' o melhor indicador de cardinalidade.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "prometheus_tsdb_head_series",
          "legendFormat": "",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Amostras ingeridas/s",
      "description": "Taxa de ingestao.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "rate(prometheus_tsdb_head_samples_appended_total[5m])",
          "legendFormat": "",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "App: requisicoes por segundo",
      "description": "rate() sobre um counter. Repare que e' sempre rate de counter - nunca de gauge.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (endpoint, status) (rate(app_requests_total[1m]))",
          "legendFormat": "{{endpoint}} {{status}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "App: latencia (percentis)",
      "description": "O 'by (le)' nao e' opcional: sem ele o histogram_quantile devolve numero errado.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(app_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(app_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Node: CPU por modo",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (mode) (rate(node_cpu_seconds_total[1m]))",
          "legendFormat": "{{mode}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Node: memoria em uso",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "100 - ((node_memory_MemAvailable_bytes * 100) / node_memory_MemTotal_bytes)",
          "legendFormat": "uso %",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Blackbox: probe_success",
      "description": "1 = alvo respondeu como esperado, 0 = falhou.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "probe_success",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Blackbox: duracao do probe",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "probe_duration_seconds",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        }
      ]
    }
  ],
  "__inputs": []
}