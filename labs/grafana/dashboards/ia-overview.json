{
  "uid": "curso-prometheus-ia",
  "title": "Curso Prometheus — observando aplicações com IA",
  "description": "Dashboard do módulo 10. Latência, tokens, custo, erros e métricas de agente.",
  "tags": [
    "curso",
    "lab",
    "ia"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Custo projetado / dia",
      "description": "predict_linear sobre a ultima hora. O mesmo do modulo 06, aplicado a dinheiro.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "predict_linear(llm_cost_usd_total[1h], 24*3600)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Custo acumulado",
      "description": "Desde que o app subiu. Zera quando o container reinicia - e' um counter.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(llm_cost_usd_total)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 de latencia",
      "description": "Vem de uma recording rule. Media nao serve aqui: a distribuicao tem cauda longa.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "max(llm:latency_p95:5m)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Taxa de erro",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(rate(gen_ai_client_errors_total[5m])) / sum(rate(gen_ai_client_operation_duration_seconds_count[5m]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Latencia: p50, p95, p99",
      "description": "A distancia entre p50 e p99 e' o ponto: e' ela que a media esconde.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Tokens por minuto",
      "description": "Entrada e saida separadas: elas tem precos diferentes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (gen_ai_token_type) (rate(gen_ai_client_tokens_total[5m]) * 60)",
          "legendFormat": "{{gen_ai_token_type}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Custo por hora, por modelo",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "llm:cost_usd:rate1h * 3600",
          "legendFormat": "{{gen_ai_request_model}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Erros por tipo",
      "description": "Separado por tipo porque a acao e' diferente: rate_limit e' quota, timeout e' paciencia, client_error e' bug.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (error_type) (rate(gen_ai_client_errors_total[5m]))",
          "legendFormat": "{{error_type}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Retries por minuto",
      "description": "Retry custa dinheiro e some do olhar de quem so' mede a chamada final.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (error_type) (rate(gen_ai_client_retries_total[5m]) * 60)",
          "legendFormat": "{{error_type}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Chamadas em andamento",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(gen_ai_client_requests_inflight)",
          "legendFormat": "inflight",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Agente: passos por execucao",
      "description": "Se isso sobe sem a qualidade melhorar, o agente esta' rodando em circulo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_invoke_agent_inference_calls_bucket[5m])))",
          "legendFormat": "p95 chamadas ao modelo",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_invoke_agent_tool_calls_bucket[5m])))",
          "legendFormat": "p95 chamadas de ferramenta",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Agente: duracao por ferramenta",
      "description": "Muitas vezes o gargalo do agente nao e' o modelo, e' uma ferramenta lenta.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_tool_name) (rate(gen_ai_execute_tool_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{gen_ai_tool_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          }
        }
      ]
    }
  ]
}